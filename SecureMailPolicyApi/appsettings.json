{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.IdentityModel": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:8080/realms/SecureMailRealm",
    "Audiences": [ "securemail-client" ],
    "MetadataAddress": "http://localhost:8080/realms/SecureMailRealm/.well-known/openid-configuration",
    "AllowedAlgorithms": [ "RS256", "RS384", "RS512", "PS256", "PS384", "PS512" ]
  }
}
